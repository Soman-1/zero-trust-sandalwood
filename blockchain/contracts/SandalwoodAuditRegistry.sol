pragma solidity ^0.8.20;

/**
 * @title SandalwoodAuditRegistry
 * @dev Immutable on-chain registry for cryptographic audit hashes and Merkle roots
 * generated by the Zero Trust Agroforestry Monitoring Platform.
 */
contract SandalwoodAuditRegistry {
    address public owner;

    struct AuditBatch {
        bytes32 merkleRoot;
        uint256 batchSize;
        uint256 blockTimestamp;
        address recorder;
        string description;
        bool exists;
    }

    // Mapping from Merkle Root to AuditBatch metadata
    mapping(bytes32 => AuditBatch) private batches;
    
    // Ordered list of recorded batch roots for historical verification
    bytes32[] public batchRoots;

    // Events
    event BatchAnchored(
        bytes32 indexed merkleRoot,
        uint256 batchSize,
        uint256 timestamp,
        address indexed recorder,
        string description
    );

    event OwnershipTransferred(
        address indexed previousOwner,
        address indexed newOwner
    );

    modifier onlyOwner() {
        require(msg.sender == owner, "Only registry owner can perform this operation");
        _;
    }

    constructor() {
        owner = msg.sender;
        emit OwnershipTransferred(address(0), msg.sender);
    }

    /**
     * @notice Transfer ownership of the registry to a new address.
     * @param _newOwner Address of the new owner.
     */
    function transferOwnership(address _newOwner) external onlyOwner {
        require(_newOwner != address(0), "New owner cannot be zero address");
        require(_newOwner != owner, "New owner must be different");
        emit OwnershipTransferred(owner, _newOwner);
        owner = _newOwner;
    }

    /**
     * @notice Record and seal an audit Merkle Root into the blockchain ledger.
     * @param _merkleRoot 32-byte SHA-256 / Keccak-256 Merkle root of the audit batch.
     * @param _batchSize Number of audit events included in this batch.
     * @param _description Descriptive tag or log range identifier.
     */
    function recordAuditBatch(
        bytes32 _merkleRoot,
        uint256 _batchSize,
        string memory _description
    ) external onlyOwner returns (bool) {
        require(_merkleRoot != bytes32(0), "Merkle root cannot be zero");
        require(_batchSize > 0 && _batchSize <= 500, "Batch size out of range");
        require(bytes(_description).length <= 128, "Description exceeds 128 bytes");
        require(!batches[_merkleRoot].exists, "Batch with this Merkle root is already anchored");

        batches[_merkleRoot] = AuditBatch({
            merkleRoot: _merkleRoot,
            batchSize: _batchSize,
            blockTimestamp: block.timestamp,
            recorder: msg.sender,
            description: _description,
            exists: true
        });

        batchRoots.push(_merkleRoot);

        emit BatchAnchored(
            _merkleRoot,
            _batchSize,
            block.timestamp,
            msg.sender,
            _description
        );

        return true;
    }

    /**
     * @notice Verify whether a Merkle root exists in the immutable registry.
     * @param _merkleRoot The 32-byte root to verify.
     */
    function verifyAuditBatch(bytes32 _merkleRoot)
        external
        view
        returns (
            bool isAnchored,
            uint256 timestamp,
            uint256 batchSize,
            address recorder
        )
    {
        AuditBatch memory b = batches[_merkleRoot];
        return (b.exists, b.blockTimestamp, b.batchSize, b.recorder);
    }

    /**
     * @notice Get total count of anchored audit batches.
     */
    function getTotalBatches() external view returns (uint256) {
        return batchRoots.length;
    }
}

# Copy to .env and replace every secret.

APP_ENV=development
DEBUG=true
SEED_DEMO_DATA=true
ALLOW_INSECURE_DEFAULTS=true
ALLOW_PUBLIC_REGISTRATION=false

JWT_SECRET=replace-with-a-unique-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=replace-with-a-unique-encryption-key

SEED_ADMIN_PASSWORD=replace-admin-password
SEED_OPERATOR_PASSWORD=replace-operator-password
MAX_MEASUREMENT_AGE_HOURS=72

DATABASE_URL=sqlite:///./zero_trust_agroforestry.db

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

BLOCKCHAIN_RPC=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_PRIVATE_KEY=

REDIS_URL=

GOOGLE_MAPS_API_KEY=
